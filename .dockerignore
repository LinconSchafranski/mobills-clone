# dependências (reinstaladas dentro do container, para garantir binários
# nativos compatíveis com a plataforma da imagem)
node_modules

# build artifacts (gerados dentro do container)
.next
out

# cliente Prisma gerado (recriado no build via `prisma generate`)
src/generated

# banco de dados local / SQLite (nunca deve ir para a imagem)
*.db
*.db-journal
*.db-wal
*.db-shm

# segredos e configuração local (a imagem recebe variáveis de ambiente em runtime)
.env
.env.*
!.env.example

# git e metadados de editor/IDE
.git
.gitignore
.vscode
.idea
.DS_Store

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# arquivos do próprio Docker (não precisam entrar no contexto de build)
Dockerfile
.dockerignore

# docs
README.md
